{
  "appId": "games.whambam.app",
  "appName": "Wham Bam",
  "webDir": "www",
  "backgroundColor": "#0A0500",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "izxzlxtowubbjiatouci.supabase.co",
      "*.supabase.co",
      "secure.xsolla.com",
      "sandbox-secure.xsolla.com",
      "*.xsolla.com",
      "accounts.google.com",
      "whambam.games"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#0A0500"
  },
  "plugins": {
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0A0500",
      "overlaysWebView": false
    },
    "ScreenOrientation": {
      "default": "portrait"
    }
  }
}
