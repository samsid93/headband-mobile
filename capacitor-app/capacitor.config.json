{
  "appId": "pk.eatneat.headband",
  "appName": "HeadBand!",
  "webDir": "www",
  "server": {
    "url": "https://gameplay.eatneat.pk",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#06060E",
      "overlaysWebView": false
    },
    "ScreenOrientation": {
      "default": "portrait"
    }
  }
}
