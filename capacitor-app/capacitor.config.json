{
  "appId": "games.whambam.app",
  "appName": "Wam Bam",
  "webDir": "www",
  "server": {
    "url": "https://whambam.games",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0A0500",
      "overlaysWebView": false
    },
    "ScreenOrientation": {
      "default": "portrait"
    }
  }
}
