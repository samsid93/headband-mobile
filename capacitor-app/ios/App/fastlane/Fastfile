default_platform(:ios)

APP_ID = "games.whambam.app"

platform :ios do
  desc "Build a signed archive and upload it to TestFlight"
  lane :beta do
    # Creates a temporary keychain and unlocks it. Without this, `cert` has
    # nowhere to install the distribution certificate on a fresh CI runner.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
      is_key_content_base64: false
    )

    # TestFlight refuses an upload whose (version, build) pair already exists.
    # The project hardcodes CURRENT_PROJECT_VERSION = 1, so every upload after
    # the first would be rejected. GITHUB_RUN_NUMBER is monotonic per workflow.
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s

    # ── Why manual signing, not automatic ────────────────────────────────────
    # Automatic signing was tried twice and cannot work for this account.
    # `xcodebuild archive` under automatic signing provisions for DEVELOPMENT,
    # so it demands an "iOS App Development" profile — and those require at
    # least one registered device. This account has none, so even
    # -allowProvisioningUpdates could not create one, and the archive failed
    # with "No profiles for 'games.whambam.app' were found".
    #
    # Distribution profiles carry no device requirement, so the fix is to
    # create the certificate and an App Store profile explicitly and archive
    # with them.
    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: APP_ID, platform: "ios")
    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Using provisioning profile: #{profile_name}")

    # Scoped to the App target and the Release configuration ONLY. Passing
    # signing settings through xcargs instead would apply them to every target
    # in the build, which is what previously broke the RevenueCat SPM
    # dependency with "conflicting provisioning settings".
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"],
      build_configurations: ["Release"]
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profile_name }
      }
    )

    # Fire-and-forget: uploads the bits and returns rather than blocking CI on
    # Apple's processing (typically 15-30 min). skip_submission leaves adding
    # testers to a group as the manual step in App Store Connect -> TestFlight.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
