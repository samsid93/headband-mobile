default_platform(:ios)

platform :ios do
  desc "Build a signed archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
      is_key_content_base64: false
    )

    # CODE_SIGN_STYLE is already Automatic in App.xcodeproj. -allowProvisioningUpdates
    # is what lets xcodebuild create/renew the distribution certificate and
    # provisioning profile itself, using the API key above — no manual profile
    # download, no separate encrypted-certs repo (no fastlane match).
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}"
    )

    # Fire-and-forget: uploads the bits and returns immediately rather than
    # blocking CI on Apple's processing (typically 15-30 min). skip_submission
    # leaves adding testers as the manual step in App Store Connect -> TestFlight.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
