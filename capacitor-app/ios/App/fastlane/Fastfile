require "securerandom"

default_platform(:ios)

APP_ID = "games.whambam.app"
KEYCHAIN_NAME = "whambam_ci"

platform :ios do
  desc "Build a signed archive and upload it to TestFlight"
  lane :beta do
    keychain_password = SecureRandom.hex(16)

    begin
      create_keychain(
        name: KEYCHAIN_NAME,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
        key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
        is_key_content_base64: false
      )

      build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s

      # ── Provisioning profile from Apple Developer ──────────────────────────
      # Downloaded directly from developer.apple.com and base64-encoded into
      # a GitHub secret. The API key handles signing identity resolution —
      # Xcode cloud signing fetches the certificate automatically when given
      # a valid API key + provisioning profile.

      profile_path = File.join(Dir.tmpdir, "distribution.mobileprovision")
      File.write(profile_path, Base64.decode64(ENV.fetch("IOS_PROVISIONING_PROFILE")))

      install_provisioning_profile(path: profile_path)

      # Extract profile name
      profile_info = `security cms -D -i "#{profile_path}" 2>/dev/null`
      profile_name = profile_info[/<key>Name<\/key>\s*<string>([^<]+)<\/string>/, 1]
      UI.message("Using provisioning profile: #{profile_name}")

      # Use get_certificates to fetch/create distribution cert via API key.
      # This downloads the cert from Apple and installs it in the keychain
      # without needing a local .p12 file.
      get_certificates(
        api_key: api_key,
        keychain_name: KEYCHAIN_NAME,
        keychain_password: keychain_password,
        platform: "ios",
        type: "distribution"
      )

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "App.xcodeproj",
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        targets: ["App"],
        build_configurations: ["Release"]
      )

      build_app(
        project: "App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: { APP_ID => profile_name }
        }
      )

      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        skip_submission: true
      )
    ensure
      if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db"))
        delete_keychain(name: KEYCHAIN_NAME)
      end
      FileUtils.rm_f(profile_path) if defined?(profile_path)
    end
  end
end
