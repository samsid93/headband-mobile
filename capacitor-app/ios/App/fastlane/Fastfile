require "securerandom"

default_platform(:ios)

APP_ID = "games.whambam.app"
KEYCHAIN_NAME = "whambam_ci"

platform :ios do
  desc "Build a signed archive and upload it to TestFlight"
  lane :beta do
    keychain_password = SecureRandom.hex(16)

    begin
      create_keychain(
        name: KEYCHAIN_NAME,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
        key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
        is_key_content_base64: false
      )

      build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s

      # ── Direct certificate + profile from Apple Developer ──────────────────
      # The .p12 certificate and .mobileprovision are exported from
      # Apple Developer portal, base64-encoded, and stored as GitHub secrets.
      # No match, no private git repo needed.

      cert_path = File.join(Dir.tmpdir, "distribution.p12")
      profile_path = File.join(Dir.tmpdir, "distribution.mobileprovision")

      # Decode certificate
      File.write(cert_path, Base64.decode64(ENV.fetch("IOS_DISTRIBUTION_CERT_P12")))

      # Decode provisioning profile
      File.write(profile_path, Base64.decode64(ENV.fetch("IOS_PROVISIONING_PROFILE")))

      # Install certificate into keychain
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV.fetch("IOS_CERT_PASSWORD"),
        keychain_name: KEYCHAIN_NAME,
        keychain_password: keychain_password
      )

      # Install provisioning profile
      install_provisioning_profile(path: profile_path)

      # Extract profile name for signing settings
      profile_info = `security cms -D -i "#{profile_path}" 2>/dev/null`
      profile_name = profile_info[/<key>Name<\/key>\s*<string>([^<]+)<\/string>/, 1]
      UI.message("Using provisioning profile: #{profile_name}")

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "App.xcodeproj",
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        targets: ["App"],
        build_configurations: ["Release"]
      )

      build_app(
        project: "App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: { APP_ID => profile_name }
        }
      )

      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        skip_submission: true
      )
    ensure
      if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db"))
        delete_keychain(name: KEYCHAIN_NAME)
      end
      # Clean up sensitive files
      FileUtils.rm_f(cert_path) if defined?(cert_path)
      FileUtils.rm_f(profile_path) if defined?(profile_path)
    end
  end
end
