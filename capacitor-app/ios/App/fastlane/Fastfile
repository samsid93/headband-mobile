require "securerandom"

default_platform(:ios)

APP_ID = "games.whambam.app"
KEYCHAIN_NAME = "whambam_ci"

platform :ios do
  desc "Build a signed archive and upload it to TestFlight"
  lane :beta do
    keychain_password = SecureRandom.hex(16)

    begin
      # An explicit keychain, created here and passed to `cert` by path.
      # setup_ci alone was not enough: it creates a keychain but `cert` did not
      # resolve it, and the run failed with "Could not find the newly generated
      # certificate installed" after successfully creating the cert at Apple.
      create_keychain(
        name: KEYCHAIN_NAME,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
        key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
        is_key_content_base64: false
      )

      # TestFlight refuses an upload whose (version, build) pair already exists.
      # The project hardcodes CURRENT_PROJECT_VERSION = 1, so every upload after
      # the first would be rejected. GITHUB_RUN_NUMBER is monotonic per workflow.
      build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s

      # ── Import distribution certificate from GitHub secret ──────────────
      # The .p12 was exported from a previous CI run and stored as a
      # base64-encoded secret. Importing it avoids `cert` creating a new
      # certificate on every run and hitting Apple's 3-cert cap.
      kc_path = File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db")

      # The WWDR intermediate cert completes the trust chain — without it
      # the imported identity is not recognised as a code signing identity.
      sh("curl", "-sL", "https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer",
         "-o", "/tmp/AppleWWDRCAG3.cer")
      sh("security", "import", "/tmp/AppleWWDRCAG3.cer", "-k", kc_path, "-T",
         "/usr/bin/codesign", "-T", "/usr/bin/security")

      p12_path = File.expand_path("~/dist_cert.p12")
      File.write(p12_path, Base64.decode64(ENV.fetch("DISTRIBUTION_CERT_P12")))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV.fetch("DISTRIBUTION_CERT_PASSWORD"),
        keychain_path: kc_path,
        keychain_password: keychain_password
      )
      File.delete(p12_path) if File.exist?(p12_path)

      # Allow codesign to access the keychain without prompting
      sh("security", "set-key-partition-list", "-S", "apple-tool:,apple:,codesign:",
         "-s", "-k", keychain_password, kc_path)

      sigh(api_key: api_key, app_identifier: APP_ID, platform: "ios", force: true)
      profile_name = lane_context[SharedValues::SIGH_NAME]
      UI.message("Using provisioning profile: #{profile_name}")

      # Scoped to the App target and the Release configuration ONLY. Passing
      # signing settings through xcargs instead would apply them to every target
      # in the build, which is what previously broke the RevenueCat SPM
      # dependency with "conflicting provisioning settings".
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "App.xcodeproj",
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        targets: ["App"],
        build_configurations: ["Release"]
      )

      build_app(
        project: "App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: { APP_ID => profile_name }
        }
      )

      # Fire-and-forget: uploads the bits and returns rather than blocking CI on
      # Apple's processing (typically 15-30 min). skip_submission leaves adding
      # testers to a group as the manual step in App Store Connect -> TestFlight.
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        skip_submission: true
      )
    ensure
      # Runs even if the build failed part-way, so a failed run cannot leave
      # signing material sitting on the runner.
      if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db"))
        delete_keychain(name: KEYCHAIN_NAME)
      end
    end
  end
end
