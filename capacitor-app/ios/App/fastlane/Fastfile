default_platform(:ios)

platform :ios do
  desc "Build a signed archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
      is_key_content_base64: false
    )

    # TestFlight refuses an upload whose (version, build) pair already exists.
    # The project has CURRENT_PROJECT_VERSION = 1 hardcoded, so every upload
    # after the first would be rejected as a duplicate. GITHUB_RUN_NUMBER is
    # monotonic per workflow, which is exactly what a build number needs.
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s

    # Do NOT pin CODE_SIGN_IDENTITY here. An earlier version set it to
    # "Apple Distribution" to pre-empt the template's hardcoded
    # "iPhone Developer", and the build failed with:
    #   "App is automatically signed for development, but a conflicting code
    #    signing identity Apple Distribution has been manually specified."
    # Under automatic signing Xcode resolves the identity itself, and pinning
    # one is a contradiction it refuses. It also broke the RevenueCat SPM
    # target, because xcargs apply to every target in the build, not just App.
    #
    # -allowProvisioningUpdates lets Xcode create/renew the certificate and
    # provisioning profile via the API key above; gym then re-signs for
    # distribution during the app-store export. No fastlane match needed.
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: [
        "-allowProvisioningUpdates",
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" ")
    )

    # Fire-and-forget: uploads the bits and returns rather than blocking CI on
    # Apple's processing (typically 15-30 min). skip_submission leaves adding
    # testers to a group as the manual step in App Store Connect -> TestFlight.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
